# Pulls the images CI publishes to GHCR and recreates only the containers whose image changed.
# Install deploy/update.sh as /opt/google-cards/update.sh.
[Unit]
Description=Update google-cards from GHCR
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/google-cards
ExecStart=/opt/google-cards/update.sh
