# SITE_ADDRESS picks the site: http://google.localhost locally (plain HTTP, nothing to trust),
# or a real domain such as google.sudhanva.me, where Caddy gets an HTTPS certificate itself.
{$SITE_ADDRESS:http://google.localhost} {
	# Hashed build assets never change: serve them from disk, precompressed, cached for a year.
	# During a deploy the app and Caddy can briefly run different builds; a file Caddy does not
	# have comes from the app's own copy instead, uncached.
	@assets path /assets/*
	handle @assets {
		root * /srv
		@found file
		@missing not file
		reverse_proxy @missing web:3000
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br zstd gzip
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
