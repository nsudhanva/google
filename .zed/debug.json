// Debug configurations (F4 or `debugger: start`). Uses debugpy from .venv.
[
  {
    "label": "Python: google (module)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "google",
    "cwd": "$ZED_WORKTREE_ROOT",
    "python": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "pythonArgs": ["-Xfrozen_modules=off"],
    "justMyCode": true
  },
  {
    "label": "Python: current file",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "python": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "pythonArgs": ["-Xfrozen_modules=off"],
    "justMyCode": true
  }
]
