// Tasks (`task: spawn`, alt-shift-t).
[
  {
    "label": "web: dev server",
    "command": "bun run dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "web: check (biome + tsc)",
    "command": "bun run check && bun run typecheck",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "web: tests",
    "command": "bun run test",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "web: end-to-end API tests",
    "command": "bun run test:e2e",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "docker: up (http://google.localhost)",
    "command": "docker compose up -d --build",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "py: ingest problems",
    "command": "uv run google ingest",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "py: check approaches",
    "command": "uv run google check",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "py: check (ruff + ty)",
    "command": "uv run ruff check && uv run ruff format --check && uv run ty check",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "py: fix (ruff)",
    "command": "uv run ruff check --fix && uv run ruff format",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
